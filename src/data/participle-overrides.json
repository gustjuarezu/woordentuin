    "bestaan": { "participle": "bestaan" },
    "uitvinden": { "participle": "uitgevonden" },
    "afkopen": { "participle": "afgekocht" },
    "onderscheiden": { "participle": "onderscheiden" },
    "onderscheiden van": { "participle": "onderscheiden" },
    "beogen": { "participle": "beoogd" },
    "opsluiten": { "participle": "opgesloten" }
  },
  "exclude": ["h1-that", "h2-about", "h10-op", "h3-twintigen"]
