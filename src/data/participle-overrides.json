    "veroveren",
    "minderen",
    "leuteren",
    "toeteren",
    "vorderen",
    "bulderen",
    "verwijderen"
  ],
  "stressedStems": ["verlenen", "verdelen"],
  "separable": ["aanmelden", "aanpassen", "inzetten", "uitputten", "afvragen", "wegjagen"],
  "noGe": ["omarmen", "overnachten", "overtuigen", "mislukken", "onderdrukken", "ondersteunen", "onderschatten"],
  "irregular": {
    "houden aan": { "participle": "gehouden" },
